<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="300.0" prefWidth="500.0" style="-fx-background-color: #fcd1ea;" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Exercicio8Controller">

    <children>

        <!-- Spinners -->
        <Spinner fx:id="spnValor1" initialValue="0" layoutX="69.0" layoutY="72.0" max="9" min="0" prefHeight="44.0" prefWidth="100.0" />

        <Spinner fx:id="spnValor2" initialValue="1" layoutX="200.0" layoutY="72.0" max="9" min="1" prefHeight="44.0" prefWidth="100.0" />

        <Spinner fx:id="spnValor3" initialValue="2" layoutX="331.0" layoutY="72.0" max="9" min="2" prefHeight="44.0" prefWidth="100.0" />

        <!-- Labels dos números sorteados -->
        <Label fx:id="lblValor1" layoutX="100.0" layoutY="130.0" prefWidth="50.0" text="-">
         <font>
            <Font name="Carlito Bold Italic" size="18.0" />
         </font></Label>

        <Label fx:id="lblValor2" layoutX="220.0" layoutY="130.0" prefWidth="50.0" text="-">
         <font>
            <Font name="Carlito Bold Italic" size="18.0" />
         </font></Label>

        <Label fx:id="lblValor3" layoutX="340.0" layoutY="130.0" prefWidth="50.0" text="-">
         <font>
            <Font name="Carlito Bold Italic" size="18.0" />
         </font></Label>

        <!-- Número completo -->
        <Label fx:id="lblResultado" layoutX="232.0" layoutY="176.0" prefWidth="100.0" text="----">
         <font>
            <Font name="Carlito Bold Italic" size="24.0" />
         </font></Label>

        <!-- Botão -->
        <Button layoutX="213.0" layoutY="218.0" mnemonicParsing="false" onAction="#sortear" style="-fx-background-color: #e402af;" text="Sortear" textFill="WHITE" />
      <Label layoutX="57.0" layoutY="24.0" text="Exercício 08: Elemento Spinner e Sorteio (Random)" textFill="#e402af">
         <font>
            <Font name="Carlito Bold Italic" size="18.0" />
         </font>
      </Label>

    </children>
</AnchorPane>
